    "diagramMarginX": 20,
    "messageMargin": 20,
    "width": 120,
    "height": 40,
    "boxMargin": 10,
    "noteMargin": 10,
    "messageAlign": "center"
  },
  "state": {
    "dividerMargin": 8
  }
}
